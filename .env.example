# ==========================================
# Life RPG — Environment Variables
# ==========================================
# Copy this file to .env.local and populate with your credentials:
#   cp .env.example .env.local

# ------------------------------------------
# Supabase Configuration (Required)
# ------------------------------------------
# Found in your Supabase Dashboard: Project Settings -> API -> Project URL & Project API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------
# Optional / Production App URL
# ------------------------------------------
# Life RPG automatically resolves callback URLs using the dynamic window/request origin.
# If deploying behind custom reverse proxies, you can optionally define the base canonical URL:
# NEXT_PUBLIC_APP_URL=https://your-deployment-domain.vercel.app

# ------------------------------------------
# Rate Limiting & Distributed Cache (Optional)
# ------------------------------------------
# Life RPG features a built-in sliding-window rate limiting engine (lib/rate-limit.ts)
# that runs locally out of the box with zero external infrastructure required.
# If deploying across multi-region serverless clusters requiring distributed Redis state:
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
